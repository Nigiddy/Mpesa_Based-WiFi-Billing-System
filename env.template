# ========================================
# M-Pesa WiFi Billing System Environment
# ========================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:3000

# Redis Configuration
# ⚠️  In production set this to your managed Redis URL (e.g. redis://user:pass@host:6379/0)
REDIS_URL=redis://localhost:6379

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=wifi_billing
# Prisma MySQL connection string
# connection_limit: max pooled connections (default is num_cpus*2+1, often just 3 on a VPS).
# pool_timeout: seconds to wait for a free connection before throwing (default 10).
DATABASE_URL="mysql://user:password@localhost:3306/wifi_billing?connection_limit=20&pool_timeout=30"

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_chars

# M-Pesa API Configuration
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_mpesa_shortcode
MPESA_PASSKEY=your_mpesa_passkey
# ⚠️  Must be a publicly reachable HTTPS URL — not ngrok, not localhost.
MPESA_CALLBACK_URL=https://yourdomain.com/mpesa/callback

# MikroTik Configuration
MIKROTIK_ENABLED=true
MIKROTIK_HOST=192.168.1.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your_mikrotik_password
MIKROTIK_PORT=8728
MIKROTIK_USE_TLS=true

# Security Configuration
# ⚠️  Generate both values with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your_session_secret_here
COOKIE_SECRET=your_cookie_secret_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_PROJECT_NAME=Qonnect WiFi
# Public frontend origin used for metadata and same-origin captive-portal redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional external captive-portal origin. Leave unset unless redirects must cross origins.
NEXT_PUBLIC_PORTAL_ORIGIN=



# Frontend Production Configuration
#
# NEXT_PUBLIC_API_URL is empty so fetch() and WebSocket() calls use relative
# paths (e.g. /api/…, /ws). In production, Caddy routes /api/* and /ws*
# to the Node backend and everything else to Next.js — all on the same
# public domain (e.g. https://portal.yourdomain.com), so cookies are
# same-origin and sent automatically on WebSocket upgrades.
NEXT_PUBLIC_API_URL=

# Replace with your actual production domain
NEXT_PUBLIC_SITE_URL=https://portal.yourdomain.com

# Leave empty unless the captive portal redirects must cross origins
NEXT_PUBLIC_PORTAL_ORIGIN=

NEXT_PUBLIC_PROJECT_NAME=Qonnect WiFi


# With NEXT_PUBLIC_API_URL empty, the backend FRONTEND_ORIGIN in index.js must 
# still be set to http://localhost:3000 (which it already is by default). 
# CORS remains in place as a defence-in-depth layer 
# for any direct browser-to-backend requests that bypass the proxy.