# ==============================================================================
# KIBARUANI WiFi Billing System — Production Docker Environment Template
# ==============================================================================
# Copy this file to .env.docker on your production VPS and populate real secrets.
# Do NOT commit .env.docker with real secrets to version control.
# ==============================================================================

# ── Server Configuration ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# Public URL of the frontend (Vercel deployment) for CORS allow-listing
# e.g., https://portal.yourdomain.com or https://kibaruani.vercel.app
FRONTEND_ORIGIN=https://portal.yourdomain.com

# ── Redis Service Configuration (Docker Internal Network) ─────────────────────
# Uses the Docker service name 'redis' within kibaruani-network
REDIS_URL=redis://redis:6379

# ── MySQL Service Configuration (Docker Internal Network) ─────────────────────
# Container internal credentials and parameters
DB_HOST=mysql
DB_PORT=3306
DB_USER=kibaruani
DB_PASSWORD=your_strong_mysql_password_here
DB_ROOT_PASSWORD=your_strong_mysql_root_password_here
DB_NAME=wifi_billing

# Prisma MySQL connection string (uses Docker service name 'mysql')
DATABASE_URL="mysql://kibaruani:your_strong_mysql_password_here@mysql:3306/wifi_billing?connection_limit=20&pool_timeout=30"

# ── Cryptographic Secrets ─────────────────────────────────────────────────────
# Minimum 32 characters, high entropy (generated via crypto.randomBytes(64).toString('hex'))
JWT_SECRET=your_production_jwt_secret_64_bytes_hex_here
COOKIE_SECRET=your_production_cookie_secret_32_bytes_hex_here
SESSION_SECRET=your_production_session_secret_32_bytes_hex_here

# ── Safaricom M-Pesa Configuration ───────────────────────────────────────────
MPESA_ENV=production
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=your_daraja_shortcode
MPESA_PASSKEY=your_daraja_passkey
# Must be a publicly reachable HTTPS domain terminated by your reverse proxy
MPESA_CALLBACK_URL=https://api.yourdomain.com/mpesa/callback

# ── MikroTik RouterOS Configuration ───────────────────────────────────────────
MIKROTIK_ENABLED=true
# Reachable IP or hostname of the MikroTik router (VPN IP or static WAN IP)
MIKROTIK_HOST=10.0.0.1
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your_mikrotik_password
# Port 8729 for api-ssl (TLS), Port 8728 for plain-text api
MIKROTIK_PORT=8729
MIKROTIK_USE_TLS=true
MIKROTIK_IDLE_TIMEOUT_SEC=600

# ── Rate Limiting & Logs ───────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
