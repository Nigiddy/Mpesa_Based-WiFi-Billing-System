# Qonnect WiFi — Reverse Proxy Configuration (Vercel + VPS Split-Domain)
#
# Architecture:
#   Vercel CDN  →  https://portal.yourdomain.com   (Next.js frontend)
#   This VPS   →  https://api.yourdomain.com       (Node backend, Docker :5000)
#
# Both domains share the same apex domain (.yourdomain.com), so
# SameSite=Lax cookies are sent cross-subdomain without any code changes.
#
# Install Caddy:  https://caddyserver.com/docs/install
# Run:            caddy run --config Caddyfile
#
# Replace every occurrence of `yourdomain.com` with your real domain.
# Caddy auto-provisions and renews Let's Encrypt TLS certificates.
#
# WebSocket note: Caddy's reverse_proxy transparently forwards the
# Upgrade: websocket / Connection: Upgrade handshake — no extra config needed.
# The backend JWT guard in services/websocket.js receives the HttpOnly
# admin_token cookie because api.yourdomain.com is same-site as portal.yourdomain.com.

# ── Global options ────────────────────────────────────────────────────────────

{
    # Structured JSON access logs at the global level
    log default {
        output file /var/log/caddy/caddy.log
        format json
    }
    # Uncomment during initial cert testing to avoid rate-limit exhaustion:
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ── API domain — all backend traffic ─────────────────────────────────────────
#
# Every path on api.yourdomain.com is proxied to the Docker backend container
# listening on 127.0.0.1:5000. This includes:
#   /api/*        — REST endpoints
#   /auth/*       — authentication
#   /ws*          — WebSocket (admin dashboard real-time updates)
#   /mpesa/*      — Safaricom STK-push callbacks
#   /hotspot/*    — captive portal static files
#   /portal*      — captive portal entry page
#   /healthz      — Docker health probe

api.yourdomain.com {

    # Proxy everything to the Docker backend
    reverse_proxy localhost:5000 {
        # Pass real client IP so Express trust-proxy + ARP lookups work
        header_up X-Real-IP        {remote_host}
        header_up X-Forwarded-For  {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Health-aware load-balancing (single upstream, keeps retries sane)
        health_uri    /healthz
        health_interval 15s
        health_timeout  5s
    }

    # Gzip REST & HTML responses; WebSocket frames are binary — Caddy skips them
    encode gzip

    # Per-domain structured access log
    log {
        output file /var/log/caddy/api-access.log
        format json
    }
}

# ── Captive-portal login domain (optional) ────────────────────────────────────
#
# MikroTik redirects unauthed devices to http://portal-login.yourdomain.com
# on port 80. Caddy will redirect to HTTPS automatically for ACME domains,
# but MikroTik's walled-garden intercept happens before TLS, so plain HTTP
# must resolve here too. If your MikroTik is configured to redirect directly
# to https://api.yourdomain.com/portal, delete this block.
#
# Uncomment and configure if you use a separate captive-portal login FQDN:
#
# portal-login.yourdomain.com {
#     redir https://api.yourdomain.com/portal{uri} permanent
# }

# ── Bare HTTP → HTTPS redirect ────────────────────────────────────────────────
# Caddy handles this automatically for every HTTPS site defined above.
# No explicit http:// block is needed.

