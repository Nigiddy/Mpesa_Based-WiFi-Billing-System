generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// L-5: Role enum for RBAC. SUPER_ADMIN retains all existing permissions.
// Adding roles now is far cheaper than retrofitting authMiddleware after
// multiple real admins exist.
enum admin_role {
  SUPER_ADMIN
  VIEWER
}

model admin {
  id             Int        @id @default(autoincrement())
  email          String     @unique(map: "Admin_email_key")
  password       String
  // L-5: Defaults to SUPER_ADMIN so no existing row breaks on migration.
  role           admin_role @default(SUPER_ADMIN)
  // AUTH-W2: Track failed login attempts and temporary lockouts.
  // failedAttempts is reset to 0 on every successful login.
  // lockedUntil, when set and in the future, blocks all login attempts.
  failedAttempts Int        @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
}

model auditlog {
  id        Int      @id @default(autoincrement())
  action    String
  userId    Int?
  details   String @db.Text
  ip        String?
  createdAt DateTime @default(now())

  @@index([action], map: "AuditLog_action_idx")
  @@index([createdAt], map: "AuditLog_createdAt_idx")
  @@index([userId], map: "AuditLog_userId_idx")
}

model payment {
  id                   Int                   @id @default(autoincrement())
  transactionId        String                @unique(map: "Payment_transactionId_key")
  userId               Int?
  phone                String
  amount               Int
  // L-3: Explicit currency field — prevents ambiguity if multi-currency support is added.
  currency             String                @default("KES")
  // L-7: Store plan key at initiation so package lookups never rely on price-matching.
  // NULL for rows created before this migration; fall back to getPackageByAmount for those.
  planKey              String?
  status               payment_status        @default(PENDING)
  mpesa_reference      String?               @unique(map: "Payment_mpesa_reference_key")
  mpesa_receipt_number String?               @unique(map: "Payment_mpesa_receipt_number_key")
  macAddress           String
  ipAddress            String?
  expiresAt            DateTime?
  requestedAt          DateTime              @default(now())
  completedAt          DateTime?
  failedAt             DateTime?
  refundedAmount       Int?                  @default(0)
  refundReason         String?
  refundedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  user                 user?                 @relation(fields: [userId], references: [id], map: "Payment_userId_fkey")
  paymentstatusupdate  paymentstatusupdate[]
  session              session[]

  @@index([createdAt], map: "Payment_createdAt_idx")
  @@index([macAddress], map: "Payment_macAddress_idx")
  // L-1: @@index([mpesa_reference]) and @@index([transactionId]) removed —
  // @unique constraints already create B-tree indexes in MySQL.
  @@index([phone, status, createdAt], map: "Payment_phone_status_createdAt_idx")
  @@index([status, createdAt], map: "Payment_status_createdAt_idx")
  @@index([status], map: "Payment_status_idx")
  @@index([userId], map: "Payment_userId_idx")
}

model paymentstatusupdate {
  id        Int                           @id @default(autoincrement())
  paymentId Int
  oldStatus paymentstatusupdate_oldStatus
  newStatus paymentstatusupdate_newStatus
  reason    String
  changedBy Int?
  createdAt DateTime                      @default(now())
  payment   payment                       @relation(fields: [paymentId], references: [id], onDelete: Cascade, map: "PaymentStatusUpdate_paymentId_fkey")

  @@index([createdAt], map: "PaymentStatusUpdate_createdAt_idx")
  @@index([paymentId], map: "PaymentStatusUpdate_paymentId_idx")
}

model session {
  id                  Int                @id @default(autoincrement())
  userId              Int?
  paymentId           Int?
  macAddress          String
  ipAddress           String?
  startTime           DateTime           @default(now())
  expiryTime          DateTime
  disconnectedAt      DateTime?
  reason              String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime
  voucherRedemptionId Int?
  payment             payment?           @relation(fields: [paymentId], references: [id], map: "Session_paymentId_fkey")
  user                user?              @relation(fields: [userId], references: [id], map: "Session_userId_fkey")
  voucherredemption   voucherredemption? @relation(fields: [voucherRedemptionId], references: [id], map: "Session_voucherRedemptionId_fkey")

  // Composite index for the most-frequent active-session query:
  // WHERE disconnectedAt IS NULL AND expiryTime > NOW()
  @@index([disconnectedAt, expiryTime], map: "Session_active_idx")
  @@index([disconnectedAt], map: "Session_disconnectedAt_idx")
  @@index([expiryTime], map: "Session_expiryTime_idx")
  @@index([macAddress], map: "Session_macAddress_idx")
  @@index([paymentId], map: "Session_paymentId_fkey")
  @@index([userId], map: "Session_userId_idx")
  @@index([voucherRedemptionId], map: "Session_voucherRedemptionId_fkey")
}

model supportrequest {
  id        Int      @id @default(autoincrement())
  phone     String
  message   String   @db.Text
  // L-6: Added fields to match what the contact form collects and persist fully.
  name      String?
  email     String?
  subject   String?
  createdAt DateTime @default(now())

  @@index([createdAt], map: "SupportRequest_createdAt_idx")
}

// L-2 CONTRACT: SystemSettings is a strict singleton — only the row with id=1
// must ever exist. The DB @default(1) does NOT prevent a second row (id=2)
// from being inserted. All code MUST use upsert({ where: { id: 1 } }).
// Never call prisma.systemSettings.create() directly.
model systemsettings {
  id                 Int      @id @default(1)
  networkName        String   @default("Qonnect")
  adminEmail         String   @default("admin@qonnect.com")
  maxConcurrentUsers Int      @default(100)
  sessionTimeout     Int      @default(2)
  autoDisconnect     Boolean  @default(true)
  currency           String   @default("KSh")
  taxRate            Float    @default(0)
  paymentGateway     String   @default("mpesa")
  mpesaTimeout       Int      @default(60)
  defaultPackage     String   @default("1hour")
  maintenanceMode    Boolean  @default(false)
  updatedBy          Int?
  updatedAt          DateTime
}

model user {
  id            Int         @id @default(autoincrement())
  phone         String      @unique(map: "User_phone_key")
  macAddress    String      @unique(map: "User_macAddress_key")
  status        user_status @default(ACTIVE)
  blockedReason String?
  lastSeen      DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  payment       payment[]
  session       session[]

  // L-1: @@index([macAddress]) and @@index([phone]) removed —
  // @unique constraints on those fields already create B-tree indexes in MySQL.
  @@index([status], map: "User_status_idx")
}

model voucher {
  id                Int                 @id @default(autoincrement())
  code              String              @unique(map: "Voucher_code_key")
  planKey           String
  // L-4: Changed from BigInt to Int. Max current duration = 24h = 86,400,000 ms,
  // which fits safely in a 32-bit signed int (max ~2.1 billion).
  // BigInt caused JSON.stringify to throw on any route serialising a raw Voucher.
  durationMs        Int
  maxUses           Int                 @default(1)
  currentUses       Int                 @default(0)
  expiresAt         DateTime?
  createdBy         Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  voucherredemption voucherredemption[]

  // L-1: @@index([code]) removed — @unique already creates the index.
  @@index([createdAt], map: "Voucher_createdAt_idx")
  @@index([expiresAt], map: "Voucher_expiresAt_idx")
  @@index([planKey], map: "Voucher_planKey_idx")
}

model voucherredemption {
  id         Int       @id @default(autoincrement())
  voucherId  Int
  macAddress String
  ipAddress  String?
  redeemedAt DateTime  @default(now())
  session    session[]
  voucher    voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade, map: "VoucherRedemption_voucherId_fkey")

  @@index([macAddress], map: "VoucherRedemption_macAddress_idx")
  @@index([redeemedAt], map: "VoucherRedemption_redeemedAt_idx")
  @@index([voucherId], map: "VoucherRedemption_voucherId_idx")
}

enum paymentstatusupdate_oldStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
  FRAUD_DETECTED
  VERIFICATION_FAILED
  COMPLETED_BUT_MAC_FAILED
  REFUNDED
}

enum user_status {
  ACTIVE
  EXPIRED
  BLOCKED
  INACTIVE
}

enum paymentstatusupdate_newStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
  FRAUD_DETECTED
  VERIFICATION_FAILED
  COMPLETED_BUT_MAC_FAILED
  REFUNDED
}

enum payment_status {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
  FRAUD_DETECTED
  VERIFICATION_FAILED
  COMPLETED_BUT_MAC_FAILED
  REFUNDED
}
